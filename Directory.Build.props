<Project>
  <PropertyGroup>
    <!-- Pinned rather than left to the SDK default of 1.0.0, which would ship InTest.Cli and
         InTest.Runtime a full major ahead of the README's own "v0, working but early" framing.
         The scaffold does NOT drive this value the way it used to: docs/superpowers/plans/
         2026-08-23-trunk-based-versioning.md's [scaffold-reads-itself] (Task 1) replaced
         InitCommand.cs's hardcoded "InTest.Runtime 0.1.0" PackageReference with an interpolation
         of CliVersion.Current, so the scaffold now follows whatever this element says rather than
         the other way around — the causality this comment used to describe is inverted from here
         on. See PackageVersionCouplingTests.RuntimeVersionExpression for the guard that now
         checks the scaffold against CliVersion.Current directly, not against this element. -->
    <Version>0.1.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- NuGet package metadata is immutable once a version is published, so this has to be
         right before the first upload — set here, not per-project, because InTest.Cli and
         InTest.Runtime are the only two packed projects and both want the same values. This
         applies repo-wide, including the four test projects and four sample APIs; all eight
         already set <IsPackable>false</IsPackable> individually (verified by inspecting every
         .csproj under tests/ and samples/ during the ownership-transfer change that added these
         properties), so the assembly-level Authors/Copyright attributes land in their DLLs like
         any other project's, but none of them can be packed or published. -->
    <Authors>Tjay Ojo</Authors>
    <Copyright>Copyright (c) 2026 Tjay Ojo</Copyright>
    <PackageProjectUrl>https://github.com/Tjayojo/intest</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Tjayojo/intest.git</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
</Project>

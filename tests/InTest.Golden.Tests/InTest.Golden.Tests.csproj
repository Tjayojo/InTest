<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.Analyzers" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/InTest.Cli/InTest.Cli.csproj" />
    <!-- The MSTest adapter, not the neutral package directly: Golden scaffolds and builds real
         projects that use TestHost/ApiTestBase, both of which now live in
         InTest.Runtime.MSTest. InTest.Runtime arrives transitively. -->
  </ItemGroup>
  <ItemGroup>
    <None Update="Specs/**;Expected/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.Analyzers" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <!-- Explicit, kept alongside the InTest.Runtime.MSTest reference below (which brings
         InTest.Runtime in transitively) rather than relying on the transitive reference alone:
         explicit beats transitive and documents that this suite tests InTest.Runtime's own
         types directly, not just what the adapter happens to expose. -->
    <ProjectReference Include="../../src/InTest.Runtime/InTest.Runtime.csproj" />
    <ProjectReference Include="../../src/InTest.Runtime.MSTest/InTest.Runtime.MSTest.csproj" />
  </ItemGroup>
</Project>
